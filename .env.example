# usados pelo docker-compose.yml (sobem o Postgres)
POSTGRES_USER="horta"
POSTGRES_PASSWORD="troque-essa-senha"
POSTGRES_DB="horta_db"
POSTGRES_PORT=5432

# usado pelo Prisma/API - precisa bater com os valores acima
DATABASE_URL="postgresql://horta:troque-essa-senha@localhost:5432/horta_db?schema=public"

JWT_SECRET="troque-isso-por-um-segredo-forte"
JWT_EXPIRES_IN="7d"

PORT=3000
# porta exposta no host quando rodar via docker compose (a API dentro do container sempre escuta na PORT acima)
API_PORT=3000
